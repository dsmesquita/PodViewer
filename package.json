{
  "name": "pod-viewer",
  "version": "0.5.0",
  "description": "Domain pods, people and delivery",
  "main": "./out/main/index.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "electron-vite dev --mode mock",
    "dev:web": "vite --config vite.web.config.ts",
    "mock:reset": "node scripts/mock.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "check": "npm run typecheck && npm run lint && npm test",
    "dist": "npm run check && npm run test:e2e && electron-builder --win",
    "test:e2e": "npm run build && node scripts/smoke.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fluentui/react-components": "^9.75.2",
    "@fluentui/react-icons": "^2.0.346",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^45.3.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
